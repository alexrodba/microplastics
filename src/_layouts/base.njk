<!DOCTYPE html>
<html lang="ca">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title if title else "Microplàstics — Un perill invisible | microplastics.cat" }}</title>
  <meta name="description" content="{{ description if description else 'Tot el que cal saber sobre els microplàstics: què són, d\'on venen, com afecten la nostra salut i el medi ambient, i què podem fer-hi.' }}" />
  {% if keywords %}<meta name="keywords" content="{{ keywords }}" />{% endif %}
  {% if noindex %}<meta name="robots" content="noindex" />{% endif %}
  <meta property="og:title" content="{{ og_title if og_title else title }}" />
  <meta property="og:description" content="{{ og_description if og_description else description }}" />
  <meta property="og:type" content="{{ 'article' if schema_type == 'Article' else 'website' }}" />
  <meta property="og:url" content="https://microplastics.cat{{ page.url }}" />
  <meta property="og:locale" content="ca_ES" />
  <meta property="og:site_name" content="microplastics.cat" />
  <meta property="og:image" content="https://microplastics.cat{% if og_image %}{{ og_image }}{% else %}/assets/og-microplastics.png{% endif %}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{ og_title if og_title else title }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ og_title if og_title else title }}" />
  <meta name="twitter:description" content="{{ og_description if og_description else description }}" />
  <meta name="twitter:image" content="https://microplastics.cat{% if og_image %}{{ og_image }}{% else %}/assets/twitter-card-microplastics.png{% endif %}" />
  <link rel="canonical" href="https://microplastics.cat{{ page.url }}" />
  <link rel="alternate" type="application/atom+xml" title="microplastics.cat — Blog" href="/feed.xml" />

  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https:; form-action 'self' https://acumbamail.com; connect-src https://acumbamail.com;" />
  <link rel="stylesheet" href="/assets/fonts/fonts.css" />
  <link rel="stylesheet" href="/assets/style.css" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://microplastics.cat/#website",
    "url": "https://microplastics.cat/",
    "name": "microplastics.cat",
    "description": "Tot el que cal saber sobre els microplàstics",
    "inLanguage": "ca"
  }
  </script>

  {%- set _isPost = ("/blog/" in page.url) and (page.url != "/blog/") %}
  {%- set _stype = "BlogPosting" if (schema_type == "Article" and _isPost) else schema_type %}
  {% if schema_type %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "{{ _stype }}",
    "@id": "https://microplastics.cat{{ page.url }}#{{ _stype | lower }}",
    "url": "https://microplastics.cat{{ page.url }}",
    "name": {{ (og_title if og_title else title) | dump | safe }},
    "description": {{ description | dump | safe }},
    "inLanguage": "ca",
    "isPartOf": { "@id": "https://microplastics.cat/#website" }{% if schema_type == "Article" %},
    "headline": {{ (og_title if og_title else title) | dump | safe }},
    "image": "https://microplastics.cat{% if og_image %}{{ og_image }}{% else %}/assets/og-microplastics.png{% endif %}",
    "datePublished": "{{ date_published }}",
    "dateModified": "{{ date_modified if date_modified else date_published }}",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://microplastics.cat{{ page.url }}" },
    "author": { "@type": "Organization", "name": "microplastics.cat", "url": "https://microplastics.cat/" },
    "publisher": { "@type": "Organization", "name": "microplastics.cat", "url": "https://microplastics.cat/", "logo": { "@type": "ImageObject", "url": "https://microplastics.cat/assets/og-microplastics-square.png" } }{% endif %}
  }
  </script>
  {% endif %}

  {% if page.url != "/" %}
  {%- set _crumb = (og_title if og_title else title) | replace(" | microplastics.cat", "") %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inici", "item": "https://microplastics.cat/" }{% if _isPost %},
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://microplastics.cat/blog/" },
      { "@type": "ListItem", "position": 3, "name": {{ _crumb | dump | safe }}, "item": "https://microplastics.cat{{ page.url }}" }{% else %},
      { "@type": "ListItem", "position": 2, "name": {{ _crumb | dump | safe }}, "item": "https://microplastics.cat{{ page.url }}" }{% endif %}
    ]
  }
  </script>
  {% endif %}

  {% if faq %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for item in faq %}
      {
        "@type": "Question",
        "name": {{ item.q | dump | safe }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
      }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
  </script>
  {% endif %}
</head>
<body>

  <!-- NAV -->
  <nav>
    <a href="/" class="nav-logo">microplastics.cat</a>
    <ul class="nav-links">
      <li><a href="/que-son-els-microplastics/">Què són</a></li>
      <li><a href="/microplastics-en-el-cos-huma/">Salut</a></li>
      <li><a href="/com-reduir-els-microplastics/">Com reduir-los</a></li>
      <li><a href="/blog/">Blog</a></li>
      <li><a href="/#newsletter" class="nav-cta">Subscriu-te</a></li>
    </ul>
  </nav>

  {{ content | safe }}

  <!-- FOOTER -->
  <footer>
    <span class="footer-logo">microplastics.cat — © 2026</span>
    <ul class="footer-links">
      <li><a href="/que-son-els-microplastics/">Què són</a></li>
      <li><a href="/microplastics-en-el-cos-huma/">Salut</a></li>
      <li><a href="/com-reduir-els-microplastics/">Com reduir-los</a></li>
      <li><a href="/fonts-de-contaminacio/">Fonts</a></li>
      <li><a href="/blog/">Blog</a></li>
      <li><a href="/referencies/">Referències</a></li>
      <li><a href="/politica-de-privacitat/">Privacitat</a></li>
      <li><a href="/transparencia/">Transparència</a></li>
      <li><a href="mailto:hola@microplastics.cat">Contacte</a></li>
    </ul>
  </footer>

  <script>
    // ── INTERSECTION OBSERVER FOR REVEALS ──
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          e.target.querySelectorAll('.scale-bar[data-width]').forEach(bar => {
            bar.style.width = bar.dataset.width + '%';
          });
        }
      });
    }, { threshold: 0.12 });

    document.querySelectorAll('.reveal, .stat, .type-card, .source-card').forEach(el => io.observe(el));

    document.querySelectorAll('.type-card').forEach((card, i) => {
      card.style.transitionDelay = (i * 0.08) + 's';
    });

    document.querySelectorAll('.source-card').forEach((card, i) => {
      card.style.transitionDelay = (i * 0.1) + 's';
    });

    document.querySelectorAll('.stat').forEach((stat, i) => {
      stat.style.transitionDelay = (i * 0.12) + 's';
    });

    document.querySelectorAll('.size-scale').forEach(el => {
      const barObs = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.querySelectorAll('.scale-bar[data-width]').forEach((bar, i) => {
              setTimeout(() => { bar.style.width = bar.dataset.width + '%'; }, i * 150);
            });
          }
        });
      }, { threshold: 0.3 });
      barObs.observe(el);
    });
  </script>

</body>
</html>
